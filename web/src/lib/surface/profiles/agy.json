{
  "id": "agy",
  "identity": {
    "binary": "agy",
    "versionCommand": [
      "agy",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+",
    "agentNames": [
      "antigravity"
    ]
  },
  "versions": [
    {
      "range": "1.4.0 - 1.4.7",
      "status": "provisional",
      "verifiedThrough": null,
      "verifiedOn": null
    },
    {
      "range": "1.1.0 - 1.1.17",
      "status": "provisional",
      "verifiedThrough": null,
      "verifiedOn": null
    }
  ],
  "idle": {
    "frame": {
      "top": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "prompt": {
        "pattern": "^>(?: (?<draft>.*))?$",
        "column": 0
      },
      "bottom": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "continuationIndent": 2,
      "maxDraftRows": 60,
      "maxTailRows": 8
    },
    "placeholders": {
      "texts": [],
      "sgr": 2,
      "fg": ["var(--ansi-8)"]
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 8,
        "footerMaxRows": 16,
        "footerRows": [
          {
            "name": "background-task",
            "pattern": "^ {2}● \\[\\d{2}:\\d{2}:\\d{2}\\] .+ running$"
          }
        ],
        "commandList": {
          "sides": ["under"],
          "pointer": "^> (?<command>/\\S+)(?: +\\S.*)?$",
          "entry": "^ {2}(?<command>/\\S+)(?: +\\S.*)?$",
          "wrapped": "^ {4,}\\S",
          "footer": {
            "pattern": "^\\s*↑/↓ Navigate · enter Select · tab Complete$",
            "maxRows": 2
          }
        }
      }
    },
    "runningRows": [
      "^esc to cancel\\b",
      "^[⠀-⣿]\\s+\\S.*\\.\\.\\.\\s*$"
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "enterWhileRunning": "queues",
    "steer": [
      "alt+m"
    ],
    "steerMinVersion": "1.4.0",
    "steerWitness": [
      {
        "pattern": "^\\s*▸ (?<text>\\S.*?)\\s*$",
        "hint": "^\\s*⎿\\s+Sending to agent\\.\\.\\.\\s*$",
        "hintGap": 0
      },
      {
        "pattern": "^> (?<text>\\S.*?)\\s*$",
        "transcript": true
      }
    ],
    "queuedRow": {
      "pattern": "^\\s*▸ (?<text>\\S.*?)\\s*$",
      "hint": "^[⠀-⣿]\\s+\\S",
      "hintGap": 2,
      "hintAbove": true
    },
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    }
  },
  "collapse": {
    "pattern": "\\[Pasted [^\\]]*\\]"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "Local macOS verification on 1.4.7 covers boxed composers, gray Auto hints, normal sends, and mid-turn Queue/Steer (dynamically aligned with settings.json queuedMessages via Enter and alt+m). See harness/agy/LOCAL_VERIFICATION.md. Still provisional: attachments and approval/question interactions are not certified. Fallback ¤"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
